# Security Configuration
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# Database Configuration (for production)

# Option 1: PostgreSQL (Recommended for production)
# DATABASE_URL=postgresql://username:password@hostname:5432/database_name

# Option 2: PostgreSQL with separate variables
# DB_NAME=your_database_name
# DB_USER=your_database_user
# DB_PASSWORD=your_database_password
# DB_HOST=localhost
# DB_PORT=5432

# Option 3: MySQL
# MYSQL_DB_NAME=your_database_name
# MYSQL_DB_USER=your_database_user
# MYSQL_DB_PASSWORD=your_database_password
# MYSQL_DB_HOST=localhost
# MYSQL_DB_PORT=3306

# Option 4: SQLite (Development only)
# Leave empty to use SQLite database

# Email Configuration (for production)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# EMAIL_USE_TLS=True

# Security Headers
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
